{
  "name": "retro-car-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync:cars": "node scripts/sync-cars.mjs",
    "sync:about": "node scripts/sync-about.mjs",
    "sync:services": "node scripts/sync-services.mjs",
    "sync:contact": "node scripts/sync-contact.mjs",
    "extract:cars": "python scripts/extract-cars-from-pdf.py",
    "extract:about": "python scripts/extract-about-car.py",
    "extract:services": "python scripts/extract-services-from-pdf.py",
    "extract:contact": "python scripts/extract-contact-map.py",
    "dev": "npm run sync:cars && npm run sync:about && npm run sync:services && npm run sync:contact && vite",
    "build": "npm run sync:cars && npm run sync:about && npm run sync:services && npm run sync:contact && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.71.0",
    "vite": "^8.1.1"
  }
}
